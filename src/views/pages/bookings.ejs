<%- include("../partials/header", { title }) %>

<section class="page-head">
  <p class="eyebrow">Reservations</p>
  <h1>My Bookings</h1>
  <p>Review your booked flights and cancel eligible reservations.</p>
</section>

<% if (!bookings.length) { %>
<div class="empty-state">
  <div class="plane-icon">🎫</div>
  <h2>No bookings yet</h2>
  <p>Start by browsing available flights and reserving your seat.</p>
  <a class="btn-primary" href="/flights">Browse Flights</a>
</div>
<% } else { %>
  <div class="card">
    <table>
      <thead>
        <tr>
          <th>Flight</th>
          <th>Departure</th>
          <th>Arrival</th>
          <th>Price</th>
          <th>Status</th>
          <th>Booked At</th>
          <th>Action</th>
        </tr>
      </thead>

      <tbody>
        <% bookings.forEach(b => { %>
          <tr>
            <td><%= b.origin %> → <%= b.destination %></td>
            <td><%= b.departure_time_display %></td>
            <td><%= b.arrival_time_display %></td>
            <td><%= b.price %></td>
            <td><%= b.status %></td>
            <td><%= b.booking_created_at_display %></td>

            <td>
              <% if (b.status === "confirmed") { %>
                <form method="POST" action="/bookings/<%= b.booking_id %>/cancel">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit">Cancel</button>
                </form>
              <% } else { %>
                <small>-</small>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include("../partials/footer") %>