<%- include("../partials/header", { title }) %>

<section class="page-head">
  <p class="eyebrow">Search Flights</p>
  <h1>Find your trip</h1>
  <p>Choose your route and departure date to view available upcoming flights.</p>
</section>

<form method="GET" action="/flights" class="form flight-search">
  <label>
    Origin
    <input type="text" name="origin" value="<%= filters.origin %>"/>
  </label>

  <label>
    Destination
    <input type="text" name="destination" value="<%= filters.destination %>"/>
  </label>

  <label>
    Departure Date
    <input type="date" name="date" value="<%= filters.date %>"/>
  </label>

  <button type="submit">Search</button>
</form>

<p class="helper-text">
  Showing upcoming flights sorted by departure time. Times shown in <%= displayTimezone %>.
</p>

<% if (user && user.role === "admin") { %>
  <p><a href="/admin/flights/new">+ Create Flight (Admin)</a></p>
<% } %>

<% if (!flights.length) { %>
  <p>No flights found.</p>
<% } else { %>
  <div class="card">
    <table>
      <thead>
        <tr>
          <th>Route</th>
          <th>Departure</th>
          <th>Arrival</th>
          <th>Seats</th>
          <th>Price</th>
          <th>Action</th>
        </tr>
      </thead>

      <tbody>
        <% flights.forEach(f => { %>
          <tr>
            <td><%= f.origin %> → <%= f.destination %></td>
            <td><%= f.departure_time_display %></td>
            <td><%= f.arrival_time_display %></td>
            <td><%= f.available_seats %>/<%= f.total_seats %></td>
            <td><%= f.price %></td>

            <td>
              <% if (user) { %>
                <% if (f.available_seats > 0) { %>
                  <form method="POST" action="/flights/<%= f.id %>/book">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit">Book</button>
                  </form>
                <% } else { %>
                  <small>Sold out</small>
                <% } %>
              <% } else { %>
                <a href="/login">Login to book</a>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include("../partials/footer") %>